<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <WebSharperSourceMap>false</WebSharperSourceMap>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Client.fs" />
    <None Include="package.json" />
    <None Include="esbuild.config.mjs" />
    <None Include="wsconfig.json" />
    <Content Include="index.html" />
    <Content Include="site.css" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WebSharper" Version="11.0.0.695-preview.1" />
    <PackageReference Include="WebSharper.FSharp" Version="11.0.0.695-preview.1" />
    <PackageReference Include="WebSharper.UI" Version="11.0.0.695-preview.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WebSharper.FullCalendar\WebSharper.FullCalendar.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="11.0.101" />
  </ItemGroup>
  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile">
    <Exec Command="npm install" />
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>
</Project>